<?xml version="1.0" encoding="utf-8"?>
<!--
  Pismo - Keyboard View Layout with Candidate Bar
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background">

    <!-- Candidate Bar -->
    <HorizontalScrollView
        android:id="@+id/candidateScrollView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/candidate_bar_height"
        android:scrollbars="none"
        android:visibility="gone"
        android:background="@color/candidate_bar_background">

        <LinearLayout
            android:id="@+id/candidateBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="4dp" />

    </HorizontalScrollView>

    <!-- Keyboard View -->
    <com.pismo.keyboard.widget.KeyboardView
        android:id="@+id/vKeyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        app:keyBackground="@drawable/key_background"
        app:keyTextColorPrimary="@color/key_text_primary"
        app:keyTextColorSecondary="@color/key_text_secondary"
        app:labelTextSize="@dimen/key_label_text_size"
        app:useKeyTextColorSecondary="true" />

</LinearLayout>
