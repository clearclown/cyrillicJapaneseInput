<?xml version="1.0" encoding="utf-8"?>
<!--
  Pismo - Bulgarian Cyrillic Keyboard Layout (BDS)

  Row 1: Ы У Е И Ш Щ К С Д З Ц (11 keys)
  Row 2: Ь Я А О Ж Г Т Н В М Ч (11 keys)
  Row 3: [Shift] Ю Й Ъ Э Ф Х П Р Л Б [Backspace]
  Row 4: [123] , [Space] . [Enter]
-->
<Keyboard xmlns:app="http://schemas.android.com/apk/res-auto"
    app:keyWidth="9.09%p"
    app:keyHeight="52dp"
    app:keyHorizontalGap="0dp"
    app:keyVerticalGap="4dp">

    <Row app:rowEdgeFlags="top">
        <Key app:keyLabel="ы" app:keyEdgeFlags="left" />
        <Key app:keyLabel="у" />
        <Key app:keyLabel="е" />
        <Key app:keyLabel="и" />
        <Key app:keyLabel="ш" />
        <Key app:keyLabel="щ" />
        <Key app:keyLabel="к" />
        <Key app:keyLabel="с" />
        <Key app:keyLabel="д" />
        <Key app:keyLabel="з" />
        <Key app:keyLabel="ц" app:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key app:keyLabel="ь" app:keyEdgeFlags="left" />
        <Key app:keyLabel="я" />
        <Key app:keyLabel="а" />
        <Key app:keyLabel="о" />
        <Key app:keyLabel="ж" />
        <Key app:keyLabel="г" />
        <Key app:keyLabel="т" />
        <Key app:keyLabel="н" />
        <Key app:keyLabel="в" />
        <Key app:keyLabel="м" />
        <Key app:keyLabel="ч" app:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key
            app:codes="-1"
            app:keyIcon="@drawable/ic_shift"
            app:keyWidth="12%p"
            app:keyEdgeFlags="left"
            app:isSticky="true"
            app:isModifier="true" />
        <Key app:keyLabel="ю" app:keyWidth="8.5%p" />
        <Key app:keyLabel="й" app:keyWidth="8.5%p" />
        <Key app:keyLabel="ъ" app:keyWidth="8.5%p" />
        <Key app:keyLabel="э" app:keyWidth="8.5%p" />
        <Key app:keyLabel="ф" app:keyWidth="8.5%p" />
        <Key app:keyLabel="х" app:keyWidth="8.5%p" />
        <Key app:keyLabel="п" app:keyWidth="8.5%p" />
        <Key app:keyLabel="р" app:keyWidth="8.5%p" />
        <Key app:keyLabel="л" app:keyWidth="8.5%p" />
        <Key
            app:codes="-5"
            app:keyIcon="@drawable/ic_backspace"
            app:keyWidth="14.5%p"
            app:keyEdgeFlags="right"
            app:isRepeatable="true" />
    </Row>

    <Row app:rowEdgeFlags="bottom">
        <Key
            app:codes="-2"
            app:keyLabel="123"
            app:keyWidth="15%p"
            app:keyEdgeFlags="left" />
        <Key
            app:keyLabel=","
            app:keyWidth="10%p" />
        <Key
            app:codes="32"
            app:keyLabel="@string/label_space"
            app:keyWidth="50%p"
            app:isRepeatable="true" />
        <Key
            app:keyLabel="."
            app:keyWidth="10%p" />
        <Key
            app:codes="-4"
            app:keyIcon="@drawable/ic_enter"
            app:keyWidth="15%p"
            app:keyEdgeFlags="right" />
    </Row>

</Keyboard>
